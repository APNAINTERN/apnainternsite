# Frontend (Vite) — shared defaults; override per environment:
#   `.env.local`      → npm run dev        (local API proxy)
#   `.env.aws.local`  → npm run dev:aws    (AWS Lambda APIs)
# See `.env.local.example` and `.env.aws.example`

VITE_SUPABASE_URL=https://unqfphgjilxpbzajcdjl.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=unqfphgjilxpbzajcdjl

# Amazon SES SMTP (ap-south-1) — set in Vercel + Supabase secrets, never commit real values
SMTP_USER=AKIAxxxxxxxxxxxxxxxx
SMTP_PASS=your-ses-smtp-password
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SES_REGION=ap-south-1
MAIL_FROM=Apna Intern <admin@apnaintern.in>
# Optional override if MAIL_FROM is not set:
# MAIL_FROM_ADDRESS=admin@apnaintern.in

# Razorpay — server + scripts use RAZORPAY_*; checkout UI uses VITE_RAZORPAY_KEY_ID (public key only)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxx

# Optional — local forgot-password API (login OTP only needs SMTP_* above)
# SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini — AI assignment builder (server-side; set in Vercel for production)
# Free tier: get key at https://aistudio.google.com/app/apikey (starts with AIza…)
GEMINI_API_KEY=
# Local dev fallback if you already use VITE_GEMINI_API_KEY:
# VITE_GEMINI_API_KEY=
