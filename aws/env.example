# AWS staging / ECS environment (copy to .env on server or Secrets Manager).
# DO NOT commit real values. Production Vercel + Supabase stay unchanged until cutover.

# ── API server ──────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# Public URL of this API (staging first, then production API domain)
# Vercel preview on aws-work branch can point here without touching prod.
AWS_API_PUBLIC_URL=https://staging-api.ezyintern.in

# ── Phase 1: still use Supabase (read-only or staging project recommended) ──
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_key

# ── Phase 2: RDS PostgreSQL (after schema + data migration) ─────────────────
# DATABASE_URL=postgresql://ezyintern:PASSWORD@ezyintern-db.xxxx.ap-south-1.rds.amazonaws.com:5432/ezyintern?sslmode=require

# ── Razorpay (use TEST keys on staging) ─────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxx
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxx

# ── Email (Amazon SES SMTP — ap-south-1) ────────────────────────────────────
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=your_ses_smtp_user
SMTP_PASS=your_ses_smtp_password
MAIL_FROM=Apna Intern <admin@apnaintern.in>

# ── Gemini (assignments AI) ─────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Optional: direct Postgres for migration scripts ─────────────────────────
# PGHOST=ezyintern-db.xxxx.ap-south-1.rds.amazonaws.com
# PGPORT=5432
# PGUSER=ezyintern
# PGPASSWORD=
# PGDATABASE=ezyintern
