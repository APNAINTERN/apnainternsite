{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "functions": {
    "api/send-bulk-mail.ts": {
      "maxDuration": 60
    },
    "api/send-mail.ts": {
      "maxDuration": 60
    },
    "api/gemini-generate.ts": {
      "maxDuration": 60
    },
    "api/razorpay-recovery.ts": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.apnaintern.in" }],
      "destination": "https://apnaintern.in/:path*",
      "permanent": true
    },
    {
      "source": "/cyber-cafe/login",
      "destination": "/cybercafe/login",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/aws-api/:path*",
      "destination": "https://eikmcrd7ei.execute-api.ap-south-1.amazonaws.com/staging/:path*"
    },
    { "source": "/((?!api/|aws-api/|google[a-zA-Z0-9]+\\.html).*)", "destination": "/index.html" }
  ]
}
