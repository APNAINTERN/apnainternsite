# Copy to `.env` in the repo root (gitignored). Used by AWS setup scripts.
# NEVER commit real values.

# ── AWS IAM user (from AWS Console → IAM → Security credentials) ─────────────
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_DEFAULT_REGION=ap-south-1

# ── Supabase (for read-only export → RDS migration) ───────────────────────────
# Supabase → Settings → Database → Connection string (URI, port 5432, direct)
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...
VITE_SUPABASE_PROJECT_ID=PROJECT_REF
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── RDS (filled automatically after `npm run aws:rds:provision`, or paste here)
RDS_MASTER_PASSWORD=YourStrongPassword12+
# DATABASE_URL=postgresql://ezyintern:PASSWORD@....rds.amazonaws.com:5432/ezyintern?sslmode=require

# ── Razorpay (use TEST keys for staging) ──────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your_test_secret
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxx

# ── Amazon SES SMTP (ap-south-1) ──────────────────────────────────────────────
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=AKIAxxxxxxxx
SMTP_PASS=your-ses-smtp-password
MAIL_FROM=Apna Intern <admin@apnaintern.in>
SES_REGION=ap-south-1

# ── Optional ──────────────────────────────────────────────────────────────────
LOCAL_JWT_SECRET=change-me-staging-jwt-secret-min-32-chars
GEMINI_API_KEY=
VITE_PUBLIC_SITE_ORIGIN=https://www.apnaintern.in
