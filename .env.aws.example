# ─────────────────────────────────────────────────────────────────────────────
# AWS API TESTING — copy to `.env.aws.local` then run:  npm run dev:aws
#
# Local frontend (:8080)  →  deployed AWS Lambda APIs
# Database: still Supabase (unchanged until RDS migration)
# Production Vercel + main branch: NOT affected
# ─────────────────────────────────────────────────────────────────────────────

# Supabase — same as live for now (Phase 1: APIs only on AWS)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_key
VITE_SUPABASE_PROJECT_ID=your_project_id

# AWS Lambda + API Gateway URL from `sam deploy` output (ApiBaseUrl)
# No trailing slash. Example:
# https://abc123.execute-api.ap-south-1.amazonaws.com/staging
VITE_SITE_API_ORIGIN=https://REPLACE_AFTER_LAMBDA_DEPLOY.execute-api.ap-south-1.amazonaws.com/staging
VITE_PUBLIC_APP_URL=https://REPLACE_AFTER_LAMBDA_DEPLOY.execute-api.ap-south-1.amazonaws.com/staging

# Use Razorpay TEST keys when testing against staging API
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxx

# Optional: add to .env for read-only Supabase → RDS export (port 5432 direct URI)
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[PASSWORD]@db.[ref].supabase.co:5432/postgres
